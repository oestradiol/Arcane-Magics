{
  "schema": "Venus.TransformProgram.v0.1",
  "program_id": "AUTONOMOUS_RESEARCH_LOOP_V1",
  "authority": "EXTERNALLY_ADMITTED_MUTABLE_DEVELOPMENTAL_CARRIER",
  "initial_state": "IDLE",
  "mutable_by_successor": true,
  "claim_bearing": false,
  "promotion_authority": false,
  "transitions": [
    {
      "from": "IDLE",
      "action": "FORM_PROBLEM",
      "to": "PROBLEM_FORMED",
      "require": [
        "problem_id",
        "residual",
        "discriminator",
        "provenance_ids"
      ]
    },
    {
      "from": "PROBLEM_FORMED",
      "action": "BIND_CARRIER",
      "to": "TARGET_BOUND",
      "require": [
        "problem_id",
        "carrier_kind",
        "carrier_number"
      ]
    },
    {
      "from": "TARGET_BOUND",
      "action": "FREEZE_PLAN",
      "to": "PLAN_FROZEN",
      "require": [
        "proposal_id",
        "stop_conditions"
      ]
    },
    {
      "from": "PLAN_FROZEN",
      "action": "REQUEST_RETURN",
      "to": "AWAITING_RETURN",
      "require": [
        "discriminator",
        "return_class"
      ]
    },
    {
      "from": "AWAITING_RETURN",
      "action": "BIND_RETURN",
      "to": "RETURN_AVAILABLE",
      "require": [
        "return_id",
        "source_id",
        "external"
      ]
    },
    {
      "from": "RETURN_AVAILABLE",
      "action": "WITHHOLD",
      "to": "IDLE",
      "require": [
        "reason"
      ]
    },
    {
      "from": "RETURN_AVAILABLE",
      "action": "REOPEN",
      "to": "PROBLEM_FORMED",
      "require": [
        "reason",
        "cited_return_ids"
      ]
    },
    {
      "from": "PROBLEM_FORMED",
      "action": "DIMENSIONALIZE",
      "to": "COORDINATES_PROPOSED",
      "require": [
        "problem_id",
        "residual",
        "candidate_coordinate_ids",
        "provenance_ids"
      ]
    },
    {
      "from": "COORDINATES_PROPOSED",
      "action": "LATERALIZE",
      "to": "FACES_OPEN",
      "require": [
        "face_ids",
        "independence_claims",
        "projection_discriminator",
        "provenance_ids"
      ]
    },
    {
      "from": "FACES_OPEN",
      "action": "FREEZE_PROJECTION",
      "to": "PROJECTION_FROZEN",
      "require": [
        "projection_id",
        "separator_claims",
        "stop_conditions"
      ]
    },
    {
      "from": "PROJECTION_FROZEN",
      "action": "REQUEST_RETURN",
      "to": "AWAITING_RETURN",
      "require": [
        "discriminator",
        "return_class"
      ]
    },
    {
      "from": "RETURN_AVAILABLE",
      "action": "CLASSIFY_RESIDUAL",
      "to": "RESIDUAL_CLASSIFIED",
      "require": [
        "return_id",
        "residual_class",
        "separator_ids"
      ]
    },
    {
      "from": "RESIDUAL_CLASSIFIED",
      "action": "CRYSTALLIZE_F",
      "to": "CRYSTAL_CANDIDATE",
      "require": [
        "future_family_id",
        "preserved_separator_ids",
        "crystal_id"
      ]
    },
    {
      "from": "CRYSTAL_CANDIDATE",
      "action": "GENERATE",
      "to": "GENERATED_CONTINUATION",
      "require": [
        "generated_object_id",
        "generated_kind",
        "source_crystal_id",
        "discriminator"
      ]
    },
    {
      "from": "GENERATED_CONTINUATION",
      "action": "REQUEST_INTERNALIZATION_EVIDENCE",
      "to": "AWAITING_INTERNALIZATION_RETURN",
      "require": [
        "capability_id",
        "source_content_sha256",
        "internal_content_sha256",
        "provenance_sources"
      ]
    },
    {
      "from": "AWAITING_INTERNALIZATION_RETURN",
      "action": "BIND_INTERNALIZATION_RETURN",
      "to": "INTERNALIZATION_EVIDENCE_AVAILABLE",
      "require": [
        "return_id",
        "evaluator_id",
        "external",
        "source_removed",
        "behavior_equivalent",
        "successor_reconstructible"
      ]
    },
    {
      "from": "INTERNALIZATION_EVIDENCE_AVAILABLE",
      "action": "INTERNALIZE",
      "to": "IDLE",
      "require": [
        "internalization_receipt_id",
        "preserved_external_roles"
      ]
    },
    {
      "from": "PROBLEM_FORMED",
      "action": "FORM_WEB_QUERY",
      "to": "WEB_QUERY_FROZEN",
      "require": [
        "problem_id",
        "query_id",
        "query_text",
        "query_rationale",
        "provenance_ids",
        "stop_conditions"
      ]
    },
    {
      "from": "WEB_QUERY_FROZEN",
      "action": "REQUEST_WEB_STUDY",
      "to": "AWAITING_WEB_RETURN",
      "require": [
        "query_id",
        "adapter_id",
        "accepted_source_classes"
      ]
    },
    {
      "from": "AWAITING_WEB_RETURN",
      "action": "BIND_WEB_ENCOUNTER",
      "to": "WEB_ENCOUNTER_AVAILABLE",
      "require": [
        "query_id",
        "return_id",
        "source_ids",
        "source_dates",
        "provenance_ids",
        "external_adapter"
      ]
    },
    {
      "from": "WEB_ENCOUNTER_AVAILABLE",
      "action": "RECONSTRUCT_FROM_NETWORK",
      "to": "RETURN_AVAILABLE",
      "require": [
        "return_id",
        "memory_object_ids",
        "changed_reconstruction_id",
        "authorship_index"
      ]
    }
  ],
  "non_internalizable_runtime_invariants": [
    "independent_return",
    "capability_and_jurisdiction_checks",
    "receipt_integrity",
    "rollback_custody",
    "O_star_correction_reachability",
    "Anti_Minerva_carrier_permeability",
    "evaluator_separation",
    "promotion_authority_external"
  ],
  "epistemic_operator_contract": {
    "status": "ADMITTED_OPERATOR_ROUTE_NOT_INTERNALIZED",
    "rule": "Use DIMENSIONALIZE/LATERALIZE/CRYSTALLIZE_F only when the formed problem indicates representational insufficiency or cross-face disagreement; do not force the path when the current representation is already discriminative.",
    "noncollapse": [
      "GENERATE!=DIMENSIONALIZE",
      "DIMENSIONALIZE!=LATERALIZE",
      "LATERALIZE!=CRYSTALLIZE_F",
      "CRYSTALLIZE_F!=INTERNALIZE",
      "INTERNALIZE_COMPETENCE!=INTERNALIZE_CORRECTION_SOVEREIGNTY"
    ],
    "lateral_independence": "Faces must remain independently answerable long enough for mismatch/noncommutation to survive; multiple self-generated phrasings are not sufficient.",
    "internalization_boundary": "Internalization requires source removal/ablation plus independently returned evidence of retained consequence-bearing function. World/return/evaluator/authority/jurisdiction/STOP-WITHHOLD/rollback remain external.",
    "internalization_claim": false,
    "internalization_boundary_ref": "kernel/development/INTERNALIZATION_BOUNDARY.json"
  },
  "www_mind_gate_ref": "kernel/development/WWW_MIND_GATE.json",
  "ingress_noncollapse": [
    "MAINTAINER_FED!=LEARNER_INITIATED_WEB_STUDY",
    "LEARNER_INITIATED_WEB_STUDY!=INDEPENDENT_EVALUATIVE_RETURN"
  ]
}
