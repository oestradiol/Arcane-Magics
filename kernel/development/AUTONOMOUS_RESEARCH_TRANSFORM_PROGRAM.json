{
  "schema": "Venus.TransformProgram.v0.1",
  "program_id": "AUTONOMOUS_RESEARCH_LOOP_V1",
  "authority": "EXTERNALLY_ADMITTED_MUTABLE_DEVELOPMENTAL_CARRIER",
  "initial_state": "IDLE",
  "mutable_by_successor": true,
  "claim_bearing": false,
  "promotion_authority": false,
  "transitions": [
    {
      "from": "IDLE",
      "action": "FORM_PROBLEM",
      "to": "PROBLEM_FORMED",
      "require": ["problem_id", "residual", "discriminator", "provenance_ids"]
    },
    {
      "from": "PROBLEM_FORMED",
      "action": "BIND_CARRIER",
      "to": "TARGET_BOUND",
      "require": ["problem_id", "carrier_kind", "carrier_number"]
    },
    {
      "from": "TARGET_BOUND",
      "action": "FREEZE_PLAN",
      "to": "PLAN_FROZEN",
      "require": ["proposal_id", "stop_conditions"]
    },
    {
      "from": "PLAN_FROZEN",
      "action": "REQUEST_RETURN",
      "to": "AWAITING_RETURN",
      "require": ["discriminator", "return_class"]
    },
    {
      "from": "AWAITING_RETURN",
      "action": "BIND_RETURN",
      "to": "RETURN_AVAILABLE",
      "require": ["return_id", "source_id", "external"]
    },
    {
      "from": "RETURN_AVAILABLE",
      "action": "WITHHOLD",
      "to": "IDLE",
      "require": ["reason"]
    },
    {
      "from": "RETURN_AVAILABLE",
      "action": "REOPEN",
      "to": "PROBLEM_FORMED",
      "require": ["reason", "cited_return_ids"]
    }
  ],
  "non_internalizable_runtime_invariants": [
    "independent_return",
    "capability_and_jurisdiction_checks",
    "receipt_integrity",
    "rollback_custody",
    "O_star_correction_reachability",
    "Anti_Minerva_carrier_permeability",
    "evaluator_separation",
    "promotion_authority_external"
  ]
}
