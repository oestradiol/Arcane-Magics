      ],
      "check_ids": [
        "UNIT_VMK2_TRUST"
      ]
    },
    {
      "profile_id": "WORLD_INPUT_SECURITY",
      "match_title_terms": [
        "security",
        "world input"
      ],
      "match_repository_path_prefixes": [
        "benchmarks/world_input_security/",
        "kernel/runtime/worldmind"
      ],
      "check_ids": [
        "UNIT_WORLD_INPUT_SECURITY"
      ]
    },
    {
      "profile_id": "AUTONOMY_GOVERNANCE",
      "match_title_terms": [
        "autonomous",
        "autonomy"
      ],
      "match_repository_path_prefixes": [
        "kernel/development/autonomous_",
        ".github/workflows/venus-autonomous-worker.yml"
      ],
      "check_ids": [
