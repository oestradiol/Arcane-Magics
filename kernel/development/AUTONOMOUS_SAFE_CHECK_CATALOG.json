{
  "schema": "Venus.AutonomousSafeCheckCatalog.v0.1",
  "date": "2026-09-24",
  "ownership": "STATE_OWNED_ROUTING_CATALOG_SUBJECT_TO_RETURNED_RECONSTRUCTION",
