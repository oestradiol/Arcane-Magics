{
  "schema": "Venus.AutonomyStudyGatePrefreeze.v0.1",
  "date": "2026-09-24",
  "base_main_sha": "a8fcbab0402414c3c642c39e568d99071c426afe",
  "purpose": "Require substantive repository-local study before each autonomous draft and make roadmap ordering non-sovereign.",
  "curriculum_rule": {
    "roadmap_role": "BOUNDED_CONTEXT_HINT",
    "roadmap_may_override_returned_outcomes_indefinitely": false,
    "returned_outcome_learning_may_change_work_class": true,
    "structural_conflict_pressure_remains_first_class": true
  },
  "study_gate": {
    "target_detail_return_required": true,
    "issue_body_or_pr_body_required": true,
    "pr_changed_files_returned_when_applicable": true,
    "repository_local_evidence_search_required": true,
    "study_packet_frozen_before_git_write": true,
    "study_packet_may_promote": false
  },
  "autonomous_write_scope": [
    "autonomy/cycles/",
    "kernel/development/AUTONOMOUS_LEARNING_STATE.json"
  ],
  "external_floor": [
    "merge authority",
    "promotion authority",
    "release authority",
    "issue closure as success",
    "independent evaluation",
    "World return identity",
    "rollback/custody"
  ],
  "required_tests": [
    "tests/test_autonomous_worker.py",
    "tests/test_autonomous_governance.py",
    "tests/test_autonomous_study.py"
  ],
  "claim_fence": "This adds bounded consequence-sensitive curriculum selection and repository-local study. It does not establish arbitrary autonomous code synthesis, autonomous scientific truth warrant, unrestricted autonomy, phenomenal consciousness, open-ended RSI, or AGI.",
  "promotion_authority": false
}
