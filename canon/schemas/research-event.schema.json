{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oestradiol/Venus-Minerva/canon/schemas/research-event.schema.json",
  "title": "ResearchEvent",
  "type": "object",
  "required": ["event_id", "event_type", "time", "provenance"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "time": {"type": "string"},
    "object_refs": {"type": "array", "items": {"type": "string"}},
    "claim_refs": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "history": {"type": "array", "items": {"type": "string"}},
        "exposure": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "register": {"type": "array", "items": {"type": "string"}},
    "frame": {"type": ["string", "null"]},
    "index": {"type": ["string", "null"]},
    "jurisdiction": {"type": ["string", "null"]},
    "transformation": {"type": ["string", "null"]},
    "receipt_refs": {"type": "array", "items": {"type": "string"}},
    "residual_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
