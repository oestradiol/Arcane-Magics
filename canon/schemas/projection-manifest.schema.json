{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oestradiol/Venus-Minerva/canon/schemas/projection-manifest.schema.json",
  "title": "ProjectionManifest",
  "type": "object",
  "required": ["projection_id", "source_domain", "target", "map", "loss"],
  "properties": {
    "projection_id": {"type": "string", "minLength": 1},
    "source_domain": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "map": {"type": "string", "minLength": 1},
    "loss": {"type": "array", "items": {"type": "string"}},
    "fiber_description": {"type": ["string", "null"]},
    "reconstruction_target": {"type": ["string", "null"]},
    "section_status": {"enum": ["NONE_KNOWN", "PARTIAL", "APPROXIMATE", "AVAILABLE", "NOT_APPLICABLE"]},
    "resource_bounds": {"type": ["string", "null"]},
    "required_provenance": {"type": "array", "items": {"type": "string"}},
    "known_failure_modes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
