{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oestradiol/Venus-Minerva/canon/schemas/decision-receipt.schema.json",
  "title": "DecisionReceipt",
  "type": "object",
  "required": ["receipt_id", "stage", "status"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["GOVERN", "AUTHORIZE", "EXECUTE", "VERIFY", "WRITE_BACK", "PUBLICATION"]},
    "status": {"type": "string", "minLength": 1},
    "object_refs": {"type": "array", "items": {"type": "string"}},
    "authorized_scope": {"type": ["string", "null"]},
    "result": {},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "dependency_updates": {"type": "array", "items": {"type": "string"}},
    "residual_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
